{
	"name": "@dsbunny/publisher-schema",
	"version": "10.0.23",
	"description": "Schema for the Publisher",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "Steve-o <fnjordy@gmail.com>",
	"license": "MIT",
	"private": false,
	"allowScripts": {
		"@dsbunny/error-schema": true,
		"@dsbunny/recipe-schema": true,
		"@dsbunny/robust-task-schema": true,
		"@dsbunny/webhook-schema": true
	},
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist node_modules package-lock.json",
		"pull:upstream": "./scripts/pull-upstream.sh",
		"rebuild": "npm run clean && npm run pull:upstream && npm install && npm run build",
		"test": "pnpm run build && node --test test/*.test.mjs"
	},
	"devDependencies": {
		"@dsbunny/error-schema": "github:dsbunny/error-schema#ee6c4fe",
		"@dsbunny/recipe-schema": "github:dsbunny/recipe-schema#f276204",
		"@dsbunny/recipedb-schema": "github:dsbunny/recipedb-schema#14a9fb5",
		"@dsbunny/robust-task-schema": "github:dsbunny/robust-task-schema#06596e4",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema#cbda3b5",
		"@dsbunny/zod-registry": "github:dsbunny/zod-registry#35c7ef6",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@dsbunny/error-schema": "github:dsbunny/error-schema",
		"@dsbunny/recipe-schema": "github:dsbunny/recipe-schema",
		"@dsbunny/recipedb-schema": "github:dsbunny/recipedb-schema",
		"@dsbunny/robust-task-schema": "github:dsbunny/robust-task-schema",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema",
		"@dsbunny/zod-registry": "github:dsbunny/zod-registry",
		"zod": "^4.3.0"
	}
}
